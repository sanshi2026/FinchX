{
  "$defs": {
    "Exchange": {
      "enum": [
        "sse",
        "szse",
        "bse"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "InstrumentId": {
      "additionalProperties": false,
      "description": "Identity for an instrument whose code, market, and kind are already known.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Code",
          "type": "string"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "kind": {
          "$ref": "#/$defs/InstrumentKind"
        },
        "exchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exchange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "market",
        "kind"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "InstrumentKind": {
      "enum": [
        "equity",
        "index",
        "etf"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
    "Market": {
      "enum": [
        "cn_a"
      ],
      "title": "Market",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "symbol": {
      "maxLength": 6,
      "minLength": 6,
      "title": "Symbol",
      "type": "string"
    },
    "instrumentId": {
      "$ref": "#/$defs/InstrumentId"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "category": {
      "enum": [
        "popular",
        "rising",
        "new",
        "technical",
        "value",
        "trend"
      ],
      "title": "Category",
      "type": "string"
    },
    "period": {
      "enum": [
        "1h",
        "24h"
      ],
      "title": "Period",
      "type": "string"
    },
    "changePct": {
      "anyOf": [
        {
          "description": "A ratio fraction, not percentage points: 4.24% is 0.0424.",
          "examples": [
            "0.0424"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Changepct"
    },
    "heat": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heat"
    },
    "rankChange": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rankchange"
    },
    "conceptTags": {
      "items": {
        "type": "string"
      },
      "title": "Concepttags",
      "type": "array"
    },
    "popularityTag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Popularitytag"
    },
    "analysisTitle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysistitle"
    },
    "analysis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis"
    },
    "searchCount": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Searchcount"
    },
    "updatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updatedat"
    },
    "pe": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pe"
    }
  },
  "required": [
    "rank",
    "symbol",
    "instrumentId",
    "name",
    "category",
    "period"
  ],
  "title": "Hotlist Stocks Dataset Payload v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/hotlist-stocks.schema.json"
}
