{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/market-orderbook.schema.json",
  "title": "FinchX Market Orderbook Dataset Payload v1",
  "type": "object",
  "properties": {
    "instrumentId": {
      "$ref": "https://schemas.finchx.invalid/v1/instrument-identity.schema.json"
    },
    "bids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Five source bid slots in original order; zero and null values are retained.",
      "items": {
        "$ref": "#/$defs/OrderbookLevel"
      }
    },
    "asks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Five source ask slots in original order; zero and null values are retained.",
      "items": {
        "$ref": "#/$defs/OrderbookLevel"
      }
    },
    "sourceTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!.*-00:00$)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Tencent-reported quote time in Shanghai time (UTC+08:00), separate from capturedAt."
    }
  },
  "required": [
    "instrumentId",
    "bids",
    "asks",
    "sourceTimestamp"
  ],
  "additionalProperties": false,
  "$defs": {
    "OrderbookLevel": {
      "title": "OrderbookLevel",
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Original Tencent source level number (1 through 5)."
        },
        "price": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
                },
                {
                  "not": {
                    "pattern": "^-"
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "description": "Source price in CNY per share; null means Tencent supplied no value."
        },
        "size": {
          "anyOf": [
            {
              "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Shares"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source quantity converted to whole shares (Tencent hands × 100); null means Tencent supplied no value."
        }
      },
      "required": [
        "level",
        "price",
        "size"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "kind": {
                  "const": "equity"
                },
                "exchange": {
                  "const": "sse"
                },
                "code": {
                  "pattern": "^(60|68)[0-9]{4}$"
                }
              },
              "required": [
                "market",
                "kind",
                "exchange",
                "code"
              ]
            }
          }
        },
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "kind": {
                  "const": "equity"
                },
                "exchange": {
                  "const": "szse"
                },
                "code": {
                  "pattern": "^(00|30)[0-9]{4}$"
                }
              },
              "required": [
                "market",
                "kind",
                "exchange",
                "code"
              ]
            }
          }
        }
      ]
    }
  ]
}
