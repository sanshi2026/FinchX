{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/market-dragon-tiger-list.schema.json",
  "$defs": {
    "Exchange": {
      "enum": [
        "sse",
        "szse",
        "bse"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "InstrumentId": {
      "additionalProperties": false,
      "description": "Identity for an instrument whose code, market, and kind are already known.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Code",
          "type": "string"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "kind": {
          "$ref": "#/$defs/InstrumentKind"
        },
        "exchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exchange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "market",
        "kind"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "InstrumentKind": {
      "enum": [
        "equity",
        "index",
        "etf"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
    "Market": {
      "enum": [
        "cn_a"
      ],
      "title": "Market",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "instrumentId": {
      "$ref": "#/$defs/InstrumentId"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "tradeDate": {
      "format": "date",
      "title": "Tradedate",
      "type": "string"
    },
    "tradeId": {
      "minLength": 1,
      "title": "Tradeid",
      "type": "string"
    },
    "closePrice": {
      "description": "Price per share; currency is CNY.",
      "examples": [
        "12.34"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Closeprice",
      "type": "string"
    },
    "changeRatio": {
      "description": "Ratio fraction; 10% is 0.10.",
      "examples": [
        "0.0424"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Changeratio",
      "type": "string"
    },
    "amount": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Amount",
      "type": "string"
    },
    "totalBuy": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Totalbuy",
      "type": "string"
    },
    "totalNet": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Totalnet",
      "type": "string"
    },
    "explanation": {
      "minLength": 1,
      "title": "Explanation",
      "type": "string"
    },
    "threeDayFlag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Threedayflag"
    },
    "themeId": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Themeid"
    },
    "themeName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Themename"
    }
  },
  "required": [
    "instrumentId",
    "name",
    "tradeDate",
    "tradeId",
    "closePrice",
    "changeRatio",
    "amount",
    "totalBuy",
    "totalNet",
    "explanation"
  ],
  "title": "MarketDragonTigerListData",
  "type": "object"
}
