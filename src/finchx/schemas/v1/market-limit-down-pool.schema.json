{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/market-limit-down-pool.schema.json",
  "title": "MarketLimitDownPoolData",
  "$defs": {
    "Exchange": {
      "enum": [
        "sse",
        "szse",
        "bse"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "InstrumentId": {
      "additionalProperties": false,
      "description": "Identity for an instrument whose code, market, and kind are already known.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Code",
          "type": "string"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "kind": {
          "$ref": "#/$defs/InstrumentKind"
        },
        "exchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exchange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "market",
        "kind"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "InstrumentKind": {
      "enum": [
        "equity",
        "index",
        "etf"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
    "Market": {
      "enum": [
        "cn_a"
      ],
      "title": "Market",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "instrumentId": {
      "$ref": "#/$defs/InstrumentId"
    },
    "tradeDate": {
      "format": "date",
      "title": "Tradedate",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "price": {
      "description": "Latest price in CNY per share.",
      "examples": [
        "12.34"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Price",
      "type": "string"
    },
    "changeRate": {
      "description": "Ratio fraction; -10% is -0.10.",
      "examples": [
        "0.0424"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Changerate",
      "type": "string"
    },
    "amount": {
      "description": "Current-session traded amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Amount",
      "type": "string"
    },
    "floatMarketCapitalization": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Floatmarketcapitalization",
      "type": "string"
    },
    "marketCapitalization": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Marketcapitalization",
      "type": "string"
    },
    "priceEarningsRatio": {
      "anyOf": [
        {
          "description": "A valuation multiple expressed in times. Finite negative values are allowed.",
          "examples": [
            "-5.25"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "EastMoney-reported dynamic P/E; source calculation details are unspecified.",
      "title": "Priceearningsratio"
    },
    "turnoverRate": {
      "description": "Ratio fraction.",
      "examples": [
        "0.0424"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Turnoverrate",
      "type": "string"
    },
    "limitDownQueueAmount": {
      "anyOf": [
        {
          "description": "Monetary amount in CNY.",
          "examples": [
            "123456.78"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "EastMoney-reported limit-down queued amount in CNY.",
      "title": "Limitdownqueueamount"
    },
    "lastLimitDownTime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastlimitdowntime"
    },
    "boardTradedAmount": {
      "anyOf": [
        {
          "description": "Monetary amount in CNY.",
          "examples": [
            "123456.78"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Amount traded at the limit-down price in CNY.",
      "title": "Boardtradedamount"
    },
    "consecutiveLimitDownDays": {
      "minimum": 1,
      "title": "Consecutivelimitdowndays",
      "type": "integer"
    },
    "limitDownOpenCount": {
      "minimum": 0,
      "title": "Limitdownopencount",
      "type": "integer"
    },
    "industry": {
      "minLength": 1,
      "title": "Industry",
      "type": "string"
    }
  },
  "required": [
    "instrumentId",
    "tradeDate",
    "name",
    "price",
    "changeRate",
    "amount",
    "floatMarketCapitalization",
    "marketCapitalization",
    "turnoverRate",
    "consecutiveLimitDownDays",
    "limitDownOpenCount",
    "industry"
  ],
  "type": "object"
}
