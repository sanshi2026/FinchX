{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/market-quote-snapshot.schema.json",
  "title": "FinchX Market Quote Snapshot Dataset Payload v1",
  "type": "object",
  "properties": {
    "instrumentId": {
      "$ref": "https://schemas.finchx.invalid/v1/instrument-identity.schema.json"
    },
    "price": {
      "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
    },
    "previousClose": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
        },
        {
          "type": "null"
        }
      ]
    },
    "open": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
        },
        {
          "type": "null"
        }
      ],
      "description": "Session open in CNY per share."
    },
    "high": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
        },
        {
          "type": "null"
        }
      ],
      "description": "Session high in CNY per share."
    },
    "low": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
        },
        {
          "type": "null"
        }
      ],
      "description": "Session low in CNY per share."
    },
    "priceChange": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
        },
        {
          "type": "null"
        }
      ]
    },
    "changeRate": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Percentage"
        },
        {
          "type": "null"
        }
      ],
      "description": "Change from previous close as a ratio fraction; 3% is 0.03."
    },
    "volume": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Shares"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cumulative session volume in shares."
    },
    "amount": {
      "anyOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Amount"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cumulative session amount in CNY."
    },
    "sourceTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!.*-00:00$)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Source-reported quote time, separate from FinchX capturedAt."
    }
  },
  "required": [
    "instrumentId",
    "price",
    "sourceTimestamp"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "kind": {
                  "const": "equity"
                },
                "exchange": {
                  "const": "sse"
                },
                "code": {
                  "pattern": "^(60|68)[0-9]{4}$"
                }
              },
              "required": [
                "market",
                "kind",
                "exchange",
                "code"
              ]
            }
          }
        },
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "kind": {
                  "const": "equity"
                },
                "exchange": {
                  "const": "szse"
                },
                "code": {
                  "pattern": "^(00|30)[0-9]{4}$"
                }
              },
              "required": [
                "market",
                "kind",
                "exchange",
                "code"
              ]
            }
          }
        },
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "kind": {
                  "const": "index"
                },
                "exchange": {
                  "const": "sse"
                },
                "code": {
                  "enum": [
                    "000001"
                  ]
                }
              },
              "required": [
                "market",
                "kind",
                "exchange",
                "code"
              ]
            }
          }
        },
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "kind": {
                  "const": "index"
                },
                "exchange": {
                  "const": "szse"
                },
                "code": {
                  "enum": [
                    "399001",
                    "399006"
                  ]
                }
              },
              "required": [
                "market",
                "kind",
                "exchange",
                "code"
              ]
            }
          }
        }
      ]
    }
  ]
}
