{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/disclosure-document-ref.schema.json",
  "title": "FinchX Disclosure DocumentRef v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "Category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source": {"type": "string", "default": "eastmoney"}
      },
      "required": ["code", "name"]
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providerId": {"type": "string", "minLength": 1},
        "sourceRecordId": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "sourceUrl": {"anyOf": [{"type": "string", "format": "uri"}, {"type": "null"}]}
      },
      "required": ["providerId"]
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordClass": {"enum": ["raw", "standardized", "derived"]},
        "transformationVersion": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "sourceReferences": {"type": "array", "items": {"type": "object"}},
        "adjustments": {"type": "array", "items": {"type": "object"}}
      },
      "required": ["recordClass", "sourceReferences", "adjustments"]
    }
  },
  "properties": {
    "documentId": {"type": "string", "minLength": 1},
    "sourceDocumentId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "publishedAt": {"type": "string", "format": "date-time"},
    "noticeDate": {"type": "string", "format": "date"},
    "sourceRecordedAt": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/Category"}},
    "relatedInstruments": {
      "type": "array",
      "items": {"$ref": "https://schemas.finchx.invalid/v1/instrument-identity.schema.json"}
    },
    "sourceUrl": {"type": "string", "format": "uri"},
    "originalDocumentUrl": {"type": "string", "format": "uri"},
    "sourceType": {"anyOf": [{"type": "string"}, {"type": "null"}]},
    "source": {"$ref": "#/$defs/Source"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "provenance": {"$ref": "#/$defs/Provenance"}
  },
  "required": ["documentId", "sourceDocumentId", "title", "publishedAt", "noticeDate", "categories", "relatedInstruments", "sourceUrl", "originalDocumentUrl", "source", "capturedAt", "provenance"]
}
