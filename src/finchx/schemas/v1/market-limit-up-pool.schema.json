{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/market-limit-up-pool.schema.json",
  "title": "MarketLimitUpPoolData",
  "$defs": {
    "Exchange": {
      "enum": [
        "sse",
        "szse",
        "bse"
      ],
      "title": "Exchange",
      "type": "string"
    },
    "InstrumentId": {
      "additionalProperties": false,
      "description": "Identity for an instrument whose code, market, and kind are already known.",
      "properties": {
        "code": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Code",
          "type": "string"
        },
        "market": {
          "$ref": "#/$defs/Market"
        },
        "kind": {
          "$ref": "#/$defs/InstrumentKind"
        },
        "exchange": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exchange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "market",
        "kind"
      ],
      "title": "InstrumentId",
      "type": "object"
    },
    "InstrumentKind": {
      "enum": [
        "equity",
        "index",
        "etf"
      ],
      "title": "InstrumentKind",
      "type": "string"
    },
    "Market": {
      "enum": [
        "cn_a"
      ],
      "title": "Market",
      "type": "string"
    },
    "MarketLimitUpStats": {
      "additionalProperties": false,
      "properties": {
        "lookbackDays": {
          "minimum": 0,
          "title": "Lookbackdays",
          "type": "integer"
        },
        "limitUpCount": {
          "minimum": 0,
          "title": "Limitupcount",
          "type": "integer"
        }
      },
      "required": [
        "lookbackDays",
        "limitUpCount"
      ],
      "title": "MarketLimitUpStats",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "instrumentId": {
      "$ref": "#/$defs/InstrumentId"
    },
    "tradeDate": {
      "format": "date",
      "title": "Tradedate",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "price": {
      "description": "Latest price in CNY per share.",
      "examples": [
        "12.34"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Price",
      "type": "string"
    },
    "changeRate": {
      "description": "Ratio fraction; 10% is 0.10.",
      "examples": [
        "0.0424"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Changerate",
      "type": "string"
    },
    "amount": {
      "description": "Current-session traded amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Amount",
      "type": "string"
    },
    "floatMarketCapitalization": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Floatmarketcapitalization",
      "type": "string"
    },
    "marketCapitalization": {
      "description": "Monetary amount in CNY.",
      "examples": [
        "123456.78"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Marketcapitalization",
      "type": "string"
    },
    "turnoverRate": {
      "description": "Ratio fraction; 5% is 0.05.",
      "examples": [
        "0.0424"
      ],
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Turnoverrate",
      "type": "string"
    },
    "consecutiveLimitUpDays": {
      "minimum": 1,
      "title": "Consecutivelimitupdays",
      "type": "integer"
    },
    "firstLimitUpTime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Firstlimituptime"
    },
    "lastLimitUpTime": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastlimituptime"
    },
    "limitUpQueueAmount": {
      "anyOf": [
        {
          "description": "Monetary amount in CNY.",
          "examples": [
            "123456.78"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitupqueueamount"
    },
    "limitUpBreakCount": {
      "minimum": 0,
      "title": "Limitupbreakcount",
      "type": "integer"
    },
    "industry": {
      "minLength": 1,
      "title": "Industry",
      "type": "string"
    },
    "limitUpStats": {
      "$ref": "#/$defs/MarketLimitUpStats"
    }
  },
  "required": [
    "instrumentId",
    "tradeDate",
    "name",
    "price",
    "changeRate",
    "amount",
    "floatMarketCapitalization",
    "marketCapitalization",
    "turnoverRate",
    "consecutiveLimitUpDays",
    "limitUpBreakCount",
    "industry",
    "limitUpStats"
  ],
  "type": "object"
}
