{
  "additionalProperties": false,
  "properties": {
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "symbol": {
      "maxLength": 6,
      "minLength": 6,
      "title": "Symbol",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "changePct": {
      "anyOf": [
        {
          "description": "A ratio fraction, not percentage points: 4.24% is 0.0424.",
          "examples": [
            "0.0424"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Changepct"
    },
    "heat": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heat"
    }
  },
  "required": [
    "rank",
    "symbol",
    "name"
  ],
  "title": "Hotlist Convertible Bonds Dataset Payload v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/hotlist-convertible-bonds.schema.json"
}
