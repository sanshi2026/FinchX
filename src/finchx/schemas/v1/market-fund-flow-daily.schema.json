{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.finchx.invalid/v1/market-fund-flow-daily.schema.json",
  "title": "Market Fund Flow Daily Dataset Payload v1",
  "type": "object",
  "properties": {
    "instrumentId": {
      "$ref": "https://schemas.finchx.invalid/v1/instrument-identity.schema.json"
    },
    "tradeDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Trading date reported by Tencent, not FinchX capture time."
    },
    "mainNetInflow": {
      "allOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Amount"
        },
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        }
      ],
      "description": "Signed main net inflow for this trading day in CNY."
    },
    "close": {
      "allOf": [
        {
          "$ref": "https://schemas.finchx.invalid/v1/units.schema.json#/$defs/Price"
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9]\\d*(?:\\.\\d+)?|0\\.\\d*[1-9]\\d*)$"
        }
      ],
      "description": "Verified daily close in CNY per share."
    }
  },
  "required": [
    "instrumentId",
    "tradeDate",
    "mainNetInflow",
    "close"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "exchange": {
                  "const": "sse"
                },
                "kind": {
                  "const": "equity"
                },
                "code": {
                  "pattern": "^(60|68)[0-9]{4}$"
                }
              },
              "required": [
                "market",
                "exchange",
                "kind",
                "code"
              ]
            }
          }
        },
        {
          "properties": {
            "instrumentId": {
              "properties": {
                "market": {
                  "const": "cn_a"
                },
                "exchange": {
                  "const": "szse"
                },
                "kind": {
                  "const": "equity"
                },
                "code": {
                  "pattern": "^(00|30)[0-9]{4}$"
                }
              },
              "required": [
                "market",
                "exchange",
                "kind",
                "code"
              ]
            }
          }
        }
      ]
    }
  ]
}
