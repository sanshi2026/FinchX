include README.md
include CHANGELOG.md
include pyproject.toml
include LICENSE
recursive-include src/finchx *.py *.json

# Tests and repository-only material stay in the repository, not in the source package.
prune tests
prune docs
prune examples
prune .firecrawl

global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude *.sqlite
global-exclude *.sqlite3
global-exclude *.db
global-exclude *.db-*
global-exclude .env
global-exclude *.env
