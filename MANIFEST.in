include README.md LICENSE
include docs/API.md
recursive-include tests *.py
graft tests/fixtures

prune .git
prune .agents
prune .codex
prune .aws
prune .venv
prune venv
prune build
prune dist
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
prune htmlcov
prune docs/tasks
global-exclude AGENTS.md .env .env.* .pypirc .DS_Store *.py[cod]
